# Copy to .env and adjust. docker compose reads this automatically.

# Database credentials (used by both the db and api services)
DB_USER=nomadforms
DB_PASSWORD=change-me-in-production
DB_NAME=nomadforms

# API
API_PORT=8000
# Leave API_KEY empty for open local/demo use. Set it in production to require
# an X-API-Key header on all write endpoints (submit, sync, status, create).
API_KEY=
# Restrict which origins may call the API from a browser. "*" is fine for a
# LAN demo; set to your PWA's origin in production.
CORS_ORIGIN=*
